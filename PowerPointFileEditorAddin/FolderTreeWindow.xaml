<Window x:Class="PowerPointFileEditorAddin.FolderTreeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PowerPointFileEditorAddin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                <TextBox x:Name="FolderNameBox" Width="150" Margin="0,0,5,0"/>
                <Button Content="Add Folder" Click="AddFolder_Click" />
            </StackPanel>
            <TreeView x:Name="FolderTree" Margin="5">
            </TreeView>
        </DockPanel>
    </Grid>
</Window>
